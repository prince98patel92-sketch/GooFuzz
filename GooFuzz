    printf "*********************************************************\n"
}

## Show Full Banner
function showFullBanner(){
    printf "*********************************************************\n"
    printf "* GooFuzz v.${version} - The Power of Google Dorks            *\n"
    printf "*                                                       *\n"
    printf "* David Utón (@David_Uton)                              *\n"
